{
  "name": "cronometragem-corraagora-desktop",
  "version": "1.0.0",
  "description": "Cronometragem e resultados do CorraAgora funcionando offline, sem internet.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind-input.css -o app/assets/css/tailwind-build.css --minify",
    "start": "npm run build:css && electron .",
    "dist": "npm run build:css && electron-builder --win"
  },
  "build": {
    "appId": "br.com.corraagora.cronometragem",
    "productName": "Cronometragem CorraAgora",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.0"
  }
}
